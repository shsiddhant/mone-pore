package templates

import "github.com/shsiddhant/mone-pore/internal/db"
import "github.com/shsiddhant/mone-pore/internal/route"

templ JournalIndex(journal db.Journal) {
	@Layout(
		journal.JournalName,
		"Quote-JournalIndex",
		NewNavActions(
			NavItem(NavItemProps{Label: "Lock", Href: route.LockJournalURL(journal.ID), Method: "POST"}),
		),
	) {
		<main>
			<h1>{ journal.JournalName }</h1>
			<p>Journal unlocked successfully.</p>
			<p>
				<a href={ route.HomeURL() }>Back to journals</a>
			</p>
		</main>
	}
}
