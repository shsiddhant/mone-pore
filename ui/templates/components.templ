package templates

import (
	"github.com/shsiddhant/mone-pore/internal/db"
	"github.com/shsiddhant/mone-pore/internal/route"
)

templ Layout(title string, quote string, navActionProps NavActionsProps) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<!-- Link to Pico.css (Version 2) -->
			<link
				rel="stylesheet"
				href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"
			/>
			<!-- Link to HTMX -->
			<script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.10/dist/htmx.min.js" integrity="sha384-H5SrcfygHmAuTDZphMHqBJLc3FhssKjG7w/CeCpFReSfwBWDTKpkzPP8c+cLsK+V" crossorigin="anonymous">
			</script>
			<title>{ title } - মনে পড়ে</title>
		</head>
		<body>
			<!-- Top Navigation Bar Header wrapped in Pico's structural container -->
			<header class="container">
				<nav>
					<ul>
						<li>
							<a href={ route.HomeURL() } style="text-decoration: none; display: inline-flex; align-items: center; justify-content: center; gap: 12px;">
								<h1
									style="
									font-size: 2.5rem;
									font-weight: 800;
									letter-spacing: -1px;
									color: var(--pico-primary);
									margin: 0;
									line-height: 1.1;
								"
								>
									মনে পড়ে
								</h1>
							</a>
						</li>
					</ul>
					<ul id="nav-actions">
						@NavActions(navActionProps)
					</ul>
				</nav>
			</header>
			<!-- Core Application Frame -->
			<main class="container" style="padding-top: 0;">
				if quote != "" {
					@QuoteBlock(quote)
				}
				<!-- This is where home.templ or journal.templ will render -->
				{ children... }
			</main>
		</body>
	</html>
}

templ QuoteBlock(quote string) {
	<blockquote
		style="
			font-style: italic;
			color: var(--pico-muted-color);
			padding-left: 1rem;
			"
	>
		“ { quote } ”
	</blockquote>
}

type NavItemComponent struct {
	templ.Component
}

type NavItemProps struct {
	Label    string
	Href     string
	Method   string
	IsActive bool
}

func NavItem(props NavItemProps) NavItemComponent {
	return NavItemComponent{
		Component: navItemTemplate(props),
	}
}

type NavActionsProps struct {
	NavItems []NavItemComponent
}

func NewNavActions(items ...NavItemComponent) NavActionsProps {
	return NavActionsProps{NavItems: items}
}

templ NavActions(props NavActionsProps) {
	for _, item := range props.NavItems {
		@item.Component
	}
}

templ navItemTemplate(props NavItemProps) {
	{{
		var ariaCurrent string
		if props.IsActive {
			ariaCurrent = "page"
		}
	}}
	if props.Method == "POST" {
		<button
			hx-post={ props.Href }
			class={ "nav-action", templ.KV("active", props.IsActive) }
			aria-current={ ariaCurrent }
		>
			{ props.Label }
		</button>
	} else {
		<a
			href={ props.Href }
			class={ "nav-action", templ.KV("active", props.IsActive) }
			aria-current={ ariaCurrent }
		>
			{ props.Label }
		</a>
	}
}

templ JournalItem(journal db.JournalSummary) {
	<a
		href={ route.JournalURL(journal.ID) }
		hx-get={ route.UnlockJournalURL(journal.ID) }
		hx-target="#unlock-modal"
		hx-swap="innerHTML"
	>
		{ journal.JournalName }
	</a>
}
